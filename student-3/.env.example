# ============================
# Backend-Service Configuration
# ============================

# URL for the database-service inside Docker
DB_URL=http://database-service:6000

# URL for the Ollama model server inside Docker
# If your container is named "ollama", this works automatically.
OLLAMA_URL=http://ollama:11434

# Default AI model to use
LLM_MODEL=llama3


# ============================
# Frontend Configuration
# ============================

# Backend API base URL (Docker or local)
# If running via docker-compose, backend-service is exposed on port 5000
BACKEND_URL=http://localhost:5000


# ============================
# Docker / Dev Environment
# ============================

# Flask debug mode
FLASK_DEBUG=1

# Optional: override ports if needed
BACKEND_PORT=5000
DATABASE_PORT=6000
OLLAMA_PORT=11434

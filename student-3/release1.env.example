# Canonical names match Student 2. Pass these into the existing backend container.
# This file is documentation; Compose does not load it automatically.
MCP_ENABLED=false
RAG_ENABLED=false
AI_ENABLED=true
MCP_URL=http://host.docker.internal:5100/mcp
RAG_SERVICE_URL=http://host.docker.internal:5003
RAG_TIMEOUT_SECONDS=180
# Shared HOST services use this address to call Student 3:
STUDENT3_BACKEND_URL=http://localhost:5009
STUDENT3_VALIDATION_SUBJECT=ASD
# Enable MCP/RAG locally after shared wiring; disable AI/MCP/RAG during container CI.
# Legacy MCP_SERVER_URL/RAG_SERVER_URL still work when canonical names are absent.

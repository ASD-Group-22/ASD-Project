# For the Student 3 backend environment. This file is NOT loaded automatically.
# Integration owner must pass these values through the existing Compose service.
MCP_ENABLED=false
RAG_ENABLED=false
AI_ENABLED=true
MCP_SERVER_URL=http://host.docker.internal:8100/mcp
RAG_SERVER_URL=http://host.docker.internal:5003

# For shared servers/runner running ON THE HOST:
STUDENT3_BACKEND_URL=http://localhost:5000
STUDENT3_VALIDATION_SUBJECT=ASD

# During CI container execution: AI_ENABLED=false, MCP_ENABLED=false, RAG_ENABLED=false.
# Enable MCP/RAG locally only after shared registration and ingestion are complete.
